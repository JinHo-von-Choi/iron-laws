{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "iron-laws hook claude-code --fail-on HIGH" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "iron-laws hook claude-code --fail-on HIGH" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "iron-laws hook claude-code --fail-on HIGH" }
        ]
      }
    ]
  }
}
